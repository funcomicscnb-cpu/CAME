{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAME Stage 23 real-mode reference_manifest row",
  "type": "object",
  "required": [
    "reference_id",
    "species",
    "species_name",
    "assembly_name",
    "assembly_accession",
    "assembly_source",
    "assembly_release",
    "assembly_report",
    "fasta",
    "fai",
    "annotation_file",
    "annotation_format",
    "annotation_source",
    "annotation_release",
    "seqname_style",
    "mitochondrial_name"
  ],
  "properties": {
    "reference_id": {"type": "string", "minLength": 1},
    "species": {"type": "string", "minLength": 1},
    "species_name": {"type": "string", "minLength": 1},
    "assembly_name": {"type": "string", "minLength": 1},
    "assembly_accession": {"type": "string", "minLength": 1},
    "assembly_source": {"type": "string", "enum": ["NCBI", "Ensembl", "UCSC", "Custom"]},
    "assembly_release": {"type": "string", "minLength": 1},
    "assembly_report": {"type": "string", "minLength": 1},
    "fasta": {"type": "string", "minLength": 1},
    "fai": {"type": "string", "minLength": 1},
    "annotation_file": {"type": "string", "minLength": 1},
    "annotation_format": {"type": "string", "enum": ["gtf", "gff3", "bed", "other"]},
    "annotation_source": {"type": "string", "minLength": 1},
    "annotation_release": {"type": "string", "minLength": 1},
    "seqname_style": {"type": "string", "enum": ["ncbi", "ensembl", "ucsc", "custom"]},
    "mitochondrial_name": {"type": "string", "minLength": 1},
    "genome_fasta": {"type": ["string", "null"]},
    "gtf": {"type": ["string", "null"]},
    "transcript_fasta": {"type": ["string", "null"]},
    "star_index": {"type": ["string", "null"]},
    "bwa_index": {"type": ["string", "null"]},
    "bowtie2_index": {"type": ["string", "null"]},
    "chrom_sizes": {"type": ["string", "null"]},
    "blacklist_bed": {"type": ["string", "null"]},
    "repeatmasker_bed": {"type": ["string", "null"]},
    "mappability_bed": {"type": ["string", "null"]},
    "busco_lineage": {"type": ["string", "null"]},
    "busco_complete": {"type": ["number", "string", "null"]},
    "annotation_version": {"type": ["string", "null"]},
    "source": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
