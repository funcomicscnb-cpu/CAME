{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAME study profile",
  "type": "object",
  "required": ["study", "phenotype_index", "hypotheses", "reporting"],
  "additionalProperties": false,
  "properties": {
    "study": {
      "type": "object",
      "required": ["profile_id", "name", "description", "version"],
      "additionalProperties": true,
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "phenotype_index": {
      "type": "object",
      "required": ["name", "formula", "components", "aggregation", "contrasts"],
      "additionalProperties": true,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "formula": {"type": "string", "minLength": 1},
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "aggregation": {"type": "string", "minLength": 1},
        "contrasts": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/contrast"}
            },
            {
              "type": "object",
              "required": ["name", "type"],
              "additionalProperties": true
            }
          ]
        }
      }
    },
    "phenotype_indexes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/index_definition"}
    },
    "phenotype_qc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_replicates_per_group": {"type": "integer", "minimum": 1},
        "fail_on_missing_components": {"type": "boolean"},
        "fail_on_unit_inconsistency": {"type": "boolean"},
        "fail_on_sparse_groups": {"type": "boolean"}
      }
    },
    "phenotype_design": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicate_key": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "group_key": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "normalization_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "derived_variables": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "external_traits": {
      "type": "array",
      "items": {"oneOf": [{"type": "string"}, {"type": "object"}]}
    },
    "covariates": {
      "type": "array",
      "items": {"oneOf": [{"type": "string"}, {"type": "object"}]}
    },
    "mechanistic_proxies": {
      "type": "array",
      "items": {"oneOf": [{"type": "string"}, {"type": "object"}]}
    },
    "condition_ranking": {
      "type": "array",
      "items": {"type": "string"}
    },
    "feature_association_targets": {
      "type": "array",
      "items": {"oneOf": [{"type": "string"}, {"type": "object"}]}
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "model_type", "response", "predictors"],
        "additionalProperties": true,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "model_type": {"type": "string", "minLength": 1},
          "response": {"type": "string", "minLength": 1},
          "predictors": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "covariates": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "phylogenetic": {"type": "boolean"},
          "stratify_by": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "reporting": {
      "type": "object",
      "required": ["phenotype_label", "condition_label", "response_label", "external_trait_label", "candidate_mechanism_label"],
      "additionalProperties": true,
      "properties": {
        "phenotype_label": {"type": "string", "minLength": 1},
        "condition_label": {"type": "string", "minLength": 1},
        "response_label": {"type": "string", "minLength": 1},
        "external_trait_label": {"type": "string", "minLength": 1},
        "candidate_mechanism_label": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "index_definition": {
      "type": "object",
      "required": ["name", "formula", "components", "aggregation", "contrasts"],
      "additionalProperties": true,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "formula": {"type": "string", "minLength": 1},
        "primary": {"type": "boolean"},
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "aggregation": {"type": "string", "minLength": 1},
        "contrasts": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/contrast"}
            },
            {
              "type": "object",
              "required": ["name", "type"],
              "additionalProperties": true
            }
          ]
        }
      }
    },
    "contrast": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": true,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {
          "type": "string",
          "enum": ["baseline_vs_response", "treated_vs_control", "timepoint_contrast", "condition_contrast"]
        },
        "baseline_condition": {"type": "string"},
        "response_condition": {"type": "string"},
        "control_condition": {"type": "string"},
        "treated_condition": {"type": "string"},
        "baseline_timepoint": {"type": "string"},
        "response_timepoint": {"type": "string"},
        "from_timepoint": {"type": "string"},
        "to_timepoint": {"type": "string"}
      }
    }
  }
}
